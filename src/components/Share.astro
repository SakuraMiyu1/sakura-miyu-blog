---
import CopyLink from './CopyLink.astro';
interface Props { title: string; image?: string; }
const { title, image = '/images/social.jpg' } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site).href;
const query = encodeURIComponent(url);
const text = encodeURIComponent(title);
const media = encodeURIComponent(new URL(image, Astro.site).href);
---
<div class="share">
  <span class="small-label">SHARE A LITTLE LOVE</span>
  <div class="share-links">
    <CopyLink url={url} label="Copy link" />
    <a href={`https://twitter.com/intent/tweet?url=${query}&text=${text}`} target="_blank" rel="noopener noreferrer" aria-label="Share on X (opens a new tab)">X ↗</a>
    <a href={`https://www.facebook.com/sharer/sharer.php?u=${query}`} target="_blank" rel="noopener noreferrer" aria-label="Share on Facebook (opens a new tab)">Facebook ↗</a>
    <a href={`https://pinterest.com/pin/create/button/?url=${query}&media=${media}&description=${text}`} target="_blank" rel="noopener noreferrer" aria-label="Share on Pinterest (opens a new tab)">Pinterest ↗</a>
  </div>
</div>
---
import CopyLink from './CopyLink.astro';
import { localeFromPath, t } from '../lib/i18n';
interface Props { title: string; image?: string; }
const { title, image = '/images/social.jpg' } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const url = new URL(Astro.url.pathname, Astro.site).href;
const query = encodeURIComponent(url);
const text = encodeURIComponent(title);
const media = encodeURIComponent(new URL(image, Astro.site).href);
---
<div class="share">
  <span class="small-label">{t(locale, 'shareTitle')}</span>
  <div class="share-links">
    <CopyLink url={url} label={t(locale, 'copyLink')} />
    <a href={`https://twitter.com/intent/tweet?url=${query}&text=${text}`} target="_blank" rel="noopener noreferrer" aria-label={`${t(locale, 'shareOn')} X (${t(locale, 'newTab')})`}>X ↗</a>
    <a href={`https://www.facebook.com/sharer/sharer.php?u=${query}`} target="_blank" rel="noopener noreferrer" aria-label={`${t(locale, 'shareOn')} Facebook (${t(locale, 'newTab')})`}>Facebook ↗</a>
    <a href={`https://pinterest.com/pin/create/button/?url=${query}&media=${media}&description=${text}`} target="_blank" rel="noopener noreferrer" aria-label={`${t(locale, 'shareOn')} Pinterest (${t(locale, 'newTab')})`}>Pinterest ↗</a>
  </div>
</div>

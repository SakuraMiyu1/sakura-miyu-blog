---
import Icon from './Icon.astro';
import { localeFromPath, localePath, t } from '../lib/i18n';
const locale = localeFromPath(Astro.url.pathname);
const links = [['home', ''], ['diary', 'diary'], ['about', 'about'], ['archive', 'archive'], ['blog', 'blog'], ['tags', 'tags']] as const;
---
<footer class="site-footer shell">
  <div class="footer-flourish" aria-hidden="true">✧ ─── ♡ ─── ✧</div>
  <a class="footer-brand" href={localePath(locale)}>Sakura Miyu's <em>Little World</em></a>
  <p>{t(locale, 'tagline')}</p>
  <p class="footer-note">{t(locale, 'footerNote')} <span aria-hidden="true">🌸</span></p>
  <nav aria-label={t(locale, 'footerNav')}>{links.map(([key, path]) => <a href={localePath(locale, path)}>{t(locale, key)}</a>)}<a href={localePath(locale, 'rss.xml')}><Icon name="rss" size={13} /> RSS</a></nav>
  <small>© {new Date().getFullYear()} Sakura Miyu's Little World</small>
</footer>

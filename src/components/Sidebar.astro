---
import { posts, allTags, formatDate, postUrl, tagUrl, categoryUrl, categories } from '../lib/blog';
import Icon from './Icon.astro';
const recent = (await posts()).slice(0, 3);
const tags = await allTags();
---
<aside class="sidebar" aria-label="About Sakura and explore the blog">
  <section class="profile-card panel"><div class="profile-cover"></div><img class="avatar" src="/images/avatar.webp" alt="Illustrated portrait of Sakura Miyu with pink hair and a black bow" width="112" height="112" loading="lazy" /><span class="eyebrow">THE GIRL BEHIND THE DIARY</span><h2>Sakura Miyu <span aria-hidden="true">🌸</span></h2><p class="profile-jp" lang="ja">さくらみゆ</p><p>A Little World Between<br />Reality &amp; Dreams</p><div class="small-divider" aria-hidden="true">✧ ♡ ✧</div><p class="profile-interests">Anime · Cosplay · Gaming<br />Writing · Gothic Kawaii</p><p class="profile-welcome" lang="ja">さくらみゆの小さな世界へようこそ 🎀🖤</p><a href="/about/" class="button button-outline">A little more about me <Icon name="heart" size={14} /></a></section>
  <section class="panel sidebar-section"><h2><Icon name="book" size={18} /> Recent pages</h2>{recent.map(post => <a class="sidebar-post" href={postUrl(post)}><span>{post.data.title}</span><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time></a>)}</section>
  <section class="panel sidebar-section"><h2><Icon name="bow" size={19} /> Little interests</h2><ul class="topic-list">{categories.map(category => <li><a href={categoryUrl(category)}>{category}<span aria-hidden="true">›</span></a></li>)}</ul></section>
  <section class="panel sidebar-section"><h2><Icon name="sparkle" size={17} /> Tags to wander through</h2><div class="tags">{tags.map(tag => <a href={tagUrl(tag)}>{tag}</a>)}</div><a class="text-link sidebar-more" href="/archive/">Open the archive <Icon name="arrow" size={15} /></a></section>
  <section class="sidebar-note"><span aria-hidden="true">☾</span><p>Somewhere between<br />a daydream and a diary.</p><span class="small-label">STAY A LITTLE WHILE</span></section>
</aside>

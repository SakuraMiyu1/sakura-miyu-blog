---
import type { Post } from '../lib/blog';
import { formatDate, languageLabel, postUrl, tagUrl, readingTime } from '../lib/blog';
import { localeFromPath, t, topicLabel } from '../lib/i18n';
import Icon from './Icon.astro';
interface Props { post: Post; featured?: boolean; headingLevel?: 'h2' | 'h3'; }
const { post, featured = false, headingLevel: Heading = 'h2' } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
---
<article class:list={['post-card', { 'featured-card': featured }]}>
  {post.data.image && <a class="post-image-link" href={postUrl(post)} tabindex="-1" aria-hidden="true"><img class="post-image" src={post.data.image} alt="" width="800" height="450" loading="lazy" /></a>}
  <div class="post-card-body"><div class="post-meta"><span class="category-label">{featured ? t(locale, 'featuredEntry') : topicLabel(post.data.category, locale)}</span><span class="language-label">{languageLabel(post.data.language)}</span></div><Heading><a href={postUrl(post)}>{post.data.title}</a></Heading><p>{post.data.description}</p><div class="tags">{post.data.tags.slice(0, 4).map(tag => <a href={tagUrl(tag, locale)}>{topicLabel(tag, locale)}</a>)}</div><div class="post-card-bottom"><span><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, locale)}</time><span class="read-time"> · {readingTime(post)} {t(locale, 'minRead')}</span></span><a href={postUrl(post)} class="text-link">{t(locale, 'readMore')} <Icon name="arrow" size={15} /><span class="sr-only">: {post.data.title}</span></a></div></div>
</article>

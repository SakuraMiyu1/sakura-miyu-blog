---
import PostCard from './PostCard.astro';
import Icon from './Icon.astro';
import { posts, categories, allTags } from '../lib/blog';
import { localeFromPath, localePath, t, topicLabel } from '../lib/i18n';
const locale = localeFromPath(Astro.url.pathname);
const entries = await posts(locale);
const tags = await allTags(locale);
---
<section data-post-listing data-locale={locale} data-index-url={localePath(locale, 'search-index.json')} data-results-label={t(locale, 'resultsFound')} data-showing-label={t(locale, 'showing')} data-error-message={t(locale, 'searchError')} aria-label={t(locale, 'findEntries')}>
  <form class="search-panel panel" action={localePath(locale, 'blog')} role="search"><label class="search-label" for="post-search">{t(locale, 'searchLabel')}</label><div class="search-input-wrap"><Icon name="search" size={20} /><input type="search" id="post-search" name="q" placeholder={t(locale, 'searchPlaceholder')} autocomplete="off" /></div><div class="filter-row"><label>{t(locale, 'category')}<select id="category-filter" name="category"><option value="">{t(locale, 'allCategories')}</option>{categories.map(category => <option value={category}>{topicLabel(category, locale)}</option>)}</select></label><label>{t(locale, 'tag')}<select id="tag-filter" name="tag"><option value="">{t(locale, 'allTagOptions')}</option>{tags.map(tag => <option value={tag}>{topicLabel(tag, locale)}</option>)}</select></label><button type="reset" class="text-button">{t(locale, 'clearFilters')}</button></div><noscript><p>{t(locale, 'noScriptSearch')} <a href={localePath(locale, 'tags')}>{t(locale, 'tags')}</a> {t(locale, 'and')} <a href={localePath(locale, 'archive')}>{t(locale, 'archive')}</a>.</p></noscript></form>
  <p class="results-count" role="status" aria-live="polite" aria-atomic="true" id="search-status">{entries.length} {t(locale, 'worldEntries')}</p>
  <div class="listing-posts">{entries.map(post => <div data-post-id={post.id}><PostCard post={post} /></div>)}</div>
  <div class="empty-state panel" id="no-results" hidden><Icon name="moon" size={30} /><h2>{t(locale, 'noResultsTitle')} <span aria-hidden="true">🌸</span></h2><p>{t(locale, 'noResultsText')}</p></div>
  <button id="load-more" class="button button-dark load-more" hidden>{t(locale, 'loadMore')} <Icon name="arrow" size={16} /></button>
</section>
<script>
  import { normalizeText, slugify } from '../lib/post-utils';
  async function initializeSearch() {
  type SearchEntry = { id: string; title: string; description: string; tags: string[]; category: string; content: string };
  const root = document.querySelector<HTMLElement>('[data-post-listing]');
  if (root) {
    const input = root.querySelector<HTMLInputElement>('#post-search')!;
    const category = root.querySelector<HTMLSelectElement>('#category-filter')!;
    const tag = root.querySelector<HTMLSelectElement>('#tag-filter')!;
    const status = root.querySelector<HTMLElement>('#search-status')!;
    const more = root.querySelector<HTMLButtonElement>('#load-more')!;
    const empty = root.querySelector<HTMLElement>('#no-results')!;
    const cards = [...root.querySelectorAll<HTMLElement>('[data-post-id]')];
    const params = new URLSearchParams(location.search);
    input.value = params.get('q') || '';
    category.value = params.get('category') || '';
    tag.value = params.get('tag') || '';
    let index: Array<SearchEntry & { text: string }> = [];
    let limit = 6;
    const update = () => {
      const words = normalizeText(input.value).trim().split(/\s+/).filter(Boolean);
      const matching = new Set(index.filter(post => {
        return (!category.value || category.value === post.category) && (!tag.value || post.tags.some(value => slugify(value) === slugify(tag.value))) && words.every(word => post.text.includes(word));
      }).map(post => post.id));
      let count = 0;
      cards.forEach(card => { const match = matching.has(card.dataset.postId!); card.hidden = !match || count >= limit; if (match) count++; });
      empty.hidden = count !== 0;
      more.hidden = count <= limit;
      status.textContent = `${count} ${root.dataset.resultsLabel}${count > limit ? ` · ${root.dataset.showingLabel} ${limit}` : ''}`;
      const next = new URLSearchParams();
      if (input.value.trim()) next.set('q', input.value.trim());
      if (category.value) next.set('category', category.value);
      if (tag.value) next.set('tag', tag.value);
      history.replaceState(null, '', `${location.pathname}${next.size ? `?${next}` : ''}`);
    };
    try {
      const response = await fetch(root.dataset.indexUrl!);
      if (!response.ok) throw new Error('Search index unavailable');
      const data: SearchEntry[] = await response.json();
      index = data.map(post => ({ ...post, text: normalizeText([post.title, post.description, post.tags.join(' '), post.category, post.content].join(' ')) }));
      update();
      input.addEventListener('input', () => { limit = 6; update(); });
      [category, tag].forEach(select => select.addEventListener('change', () => { limit = 6; update(); }));
      root.querySelector('form')?.addEventListener('submit', event => { event.preventDefault(); limit = 6; update(); });
      root.querySelector('form')?.addEventListener('reset', () => { input.value = ''; category.value = ''; tag.value = ''; limit = 6; update(); });
      more.addEventListener('click', () => {
        const visible = new Set(cards.filter(card => !card.hidden));
        limit += 6; update();
        cards.find(card => !card.hidden && !visible.has(card))?.querySelector<HTMLAnchorElement>('.post-card h2 a, .post-card h3 a')?.focus();
      });
    } catch {
      status.textContent = root.dataset.errorMessage!;
    }
  }
  }
  void initializeSearch();
</script>

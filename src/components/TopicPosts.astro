---
import PostCard from './PostCard.astro';
import Icon from './Icon.astro';
import type { Post } from '../lib/blog';
import { localeFromPath, localePath, t } from '../lib/i18n';
interface Props { entries: Post[]; headingLevel?: 'h2' | 'h3'; }
const { entries, headingLevel = 'h2' } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
---
{entries.length ? entries.map(post => <PostCard post={post} headingLevel={headingLevel} />) : <section class="empty-state panel"><Icon name="flower" size={35} /><h2>{t(locale, 'noPostsTitle')}</h2><p>{t(locale, 'noPostsDescription')}</p><a href={localePath(locale, 'blog')} class="button button-dark">{t(locale, 'exploreDiary')} <Icon name="arrow" size={15} /></a></section>}

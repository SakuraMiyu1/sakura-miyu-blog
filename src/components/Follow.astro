---
import Icon from './Icon.astro';
import CopyLink from './CopyLink.astro';
import { localeFromPath, localePath, t } from '../lib/i18n';
const locale = localeFromPath(Astro.url.pathname);
const blogUrl = new URL(localePath(locale), Astro.site).href;
---
<section class="panel sidebar-section follow-sidebar" aria-labelledby="follow-title">
  <h2 id="follow-title">{t(locale, 'followTitle')} <span aria-hidden="true">🎀</span></h2>
  <p>{t(locale, 'followText')}</p>
  <div class="follow-actions">
    <a class="button button-dark" href={localePath(locale, 'rss.xml')}><Icon name="rss" size={16} /> {t(locale, 'rss')}</a>
    <CopyLink url={blogUrl} label={t(locale, 'copyBlog')} message={t(locale, 'copiedBlog')} />
  </div>
</section>

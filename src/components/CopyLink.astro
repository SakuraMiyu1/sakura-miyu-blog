---
import { localeFromPath, t } from '../lib/i18n';
interface Props { url: string; label: string; message?: string; }
const locale = localeFromPath(Astro.url.pathname);
const { url, label, message = t(locale, 'copied') } = Astro.props;
---
<span class="copy-control" data-copy-url={url} data-copy-message={message} data-copy-fallback={t(locale, 'copyFallback')}>
  <button type="button" class="copy-button">{label}</button>
  <span class="copy-status" role="status" aria-live="polite" aria-atomic="true"></span>
  <input class="copy-fallback" aria-label={`${label}: ${t(locale, 'copyAddress')}`} readonly hidden />
</span>
<script>
  document.querySelectorAll<HTMLElement>('[data-copy-url]').forEach(control => {
    const button = control.querySelector<HTMLButtonElement>('button')!;
    const status = control.querySelector<HTMLElement>('.copy-status')!;
    const fallback = control.querySelector<HTMLInputElement>('.copy-fallback')!;
    button.addEventListener('click', async () => {
      const url = control.dataset.copyUrl!;
      try {
        await navigator.clipboard.writeText(url);
        fallback.hidden = true;
        status.textContent = control.dataset.copyMessage!;
      } catch {
        fallback.value = url;
        fallback.hidden = false;
        fallback.focus();
        fallback.select();
        status.textContent = control.dataset.copyFallback!;
      }
    });
  });
</script>

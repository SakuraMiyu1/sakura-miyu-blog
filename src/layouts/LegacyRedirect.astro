---
interface Props { to: string; }
const { to } = Astro.props;
---
<!doctype html>
<html lang="uk" data-redirect-target={to}><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Redirect: {Astro.url.pathname}</title><meta name="description" content="Цю сторінку перенесено до мовного розділу сайту." /><link rel="canonical" href={new URL(to, Astro.site)} /><meta http-equiv="refresh" content={`0;url=${to}`} /></head><body><p><a href={to}>Перейти / Continue / 続ける →</a></p></body></html>

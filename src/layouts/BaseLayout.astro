---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../lib/site';
import '../styles/global.css';
interface Props { title?: string; description?: string; image?: string; article?: boolean; noindex?: boolean; lang?: string; }
const { title, description = site.description, image = '/images/social.jpg', article = false, noindex = false, lang = 'en' } = Astro.props;
const pageTitle = title ? `${title} | ${site.title}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
const websiteSchema = { '@context': 'https://schema.org', '@type': 'WebSite', name: site.title, description: site.description, url: new URL('/', Astro.site).href, inLanguage: ['en', 'uk', 'ja'], author: { '@type': 'Person', name: site.author } };
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="CVr517Qz-THPv1jYKzmkHS3JK0shjREDXUHJVfKGuCc" />
    <meta name="theme-color" content="#17121C" />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="icon" type="image/x-icon" sizes="32x32" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="Sakura Miyu's Little World, a pink and black Gothic Kawaii diary" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Sakura Miyu's Little World, a pink and black Gothic Kawaii diary" />
    {Astro.url.pathname === '/' && <script type="application/ld+json" set:html={JSON.stringify(websiteSchema).replace(/</g, '\\u003c')} />}
    <script is:inline>document.documentElement.classList.add('js-enabled');</script>
    <slot name="head" />
  </head>
  <body><a class="skip-link" href="#main">Skip to content</a><Header /><slot /><Footer /></body>
</html>
---
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import { localeFromPath, t } from '../lib/i18n';
interface Props { title: string; description: string; eyebrow?: string; seoTitle?: string; }
const { title, description, seoTitle = title, eyebrow = t(localeFromPath(Astro.url.pathname), 'eyebrow') } = Astro.props;
---
<BaseLayout title={seoTitle} description={description}>
  <main id="main" class="shell page-main">
    <div class="page-heading"><span class="eyebrow">{eyebrow}</span><h1>{title}</h1><p>{description}</p></div>
    <div class="content-grid"><div class="main-column"><slot /></div><Sidebar /></div>
  </main>
</BaseLayout>

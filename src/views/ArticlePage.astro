---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import Share from '../components/Share.astro';
import PostCard from '../components/PostCard.astro';
import { relatedPosts, postUrl, tagUrl, formatDate, readingTime, type Post, posts } from '../lib/blog';
import { site } from '../lib/site';
import { localeFromPath, localePath, topicLabel, t } from '../lib/i18n';
interface Props { post: Post; }
const { post } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const entries = await posts(locale);
const index = entries.findIndex(entry => entry.id === post.id);
const previous = entries[index + 1];
const next = entries[index - 1];
const related = relatedPosts(post, entries);
const { Content } = await render(post);
const jsonLd = { '@context': 'https://schema.org', '@type': 'BlogPosting', headline: post.data.title, description: post.data.seoDescription || post.data.description, datePublished: post.data.pubDate.toISOString(), dateModified: (post.data.updatedDate || post.data.pubDate).toISOString(), author: { '@type': 'Person', name: site.author, url: new URL(localePath(locale, 'about'), Astro.site).href }, mainEntityOfPage: new URL(postUrl(post), Astro.site).href, image: new URL(post.data.image || '/images/social.jpg', Astro.site).href, keywords: post.data.tags.map(tag => topicLabel(tag, locale)).join(', '), inLanguage: locale, publisher: { '@type': 'Person', name: site.author } };
---
<BaseLayout title={post.data.seoTitle || post.data.title} description={post.data.seoDescription || post.data.description} image={post.data.image} article>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} /><meta property="article:published_time" content={post.data.pubDate.toISOString()} /><meta property="article:modified_time" content={(post.data.updatedDate || post.data.pubDate).toISOString()} /></Fragment>
  <main id="main" class="shell page-main"><a href={localePath(locale, 'blog')} class="text-link back-link">← {t(locale, 'backBlog')}</a><div class="content-grid"><div class="main-column">
    <article class="post-detail panel"><header class="post-detail-header"><span class="eyebrow">{topicLabel(post.data.category, locale)}</span><h1>{post.data.title}</h1><div class="post-date"><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, locale)}</time><span> · {readingTime(post)} {t(locale, 'minRead')}</span>{post.data.updatedDate && <span> · {t(locale, 'updated')} <time datetime={post.data.updatedDate.toISOString()}>{formatDate(post.data.updatedDate, locale)}</time></span>}</div><div class="tags">{post.data.tags.map(tag => <a href={tagUrl(tag, locale)}>{topicLabel(tag, locale)}</a>)}</div></header>
    {post.data.image && <img class="post-cover" src={post.data.image} alt={post.data.imageAlt || t(locale, 'imageAlt')} width="800" height="450" fetchpriority="high" />}
    <div class="prose"><Content /></div><div class="author-signature"><img src="/images/avatar.webp" alt="" width="44" height="44" loading="lazy" /><div>{t(locale, 'signature')}<strong>Sakura Miyu <span aria-hidden="true">♡</span></strong></div></div><Share title={post.data.title} image={post.data.image} /></article>
    <section class="continue-exploring" aria-labelledby="continue-heading"><h2 id="continue-heading">{t(locale, 'continueTitle')} <span aria-hidden="true">🌸</span></h2>{(previous || next) && <nav class="post-pagination" aria-label={t(locale, 'continueTitle')}>{previous && <a href={postUrl(previous)} rel="prev"><span class="small-label">← {t(locale, 'previousPost')}</span>{previous.data.title}</a>}{next && <a href={postUrl(next)} rel="next"><span class="small-label">{t(locale, 'nextPost')} →</span>{next.data.title}</a>}</nav>}<a href={localePath(locale, 'blog')} class="text-link">← {t(locale, 'backBlog')}</a></section>
    {related.length > 0 && <section class="related" aria-labelledby="related-heading"><h2 id="related-heading">{t(locale, 'relatedTitle')}</h2>{related.map(entry => <PostCard post={entry} headingLevel="h3" />)}</section>}
  </div><Sidebar /></div></main>
</BaseLayout>

---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import Follow from '../../components/Follow.astro';
import Share from '../../components/Share.astro';
import PostCard from '../../components/PostCard.astro';
import { posts, postUrl, tagUrl, formatDate, languageLabel, readingTime, type Post } from '../../lib/blog';
import { site } from '../../lib/site';
export async function getStaticPaths() {
  const entries = await posts();
  return entries.map((post, index) => ({ params: { slug: post.id }, props: { post, previous: entries[index + 1], next: entries[index - 1], related: entries.filter(other => other.id !== post.id && other.data.tags.some(tag => post.data.tags.includes(tag))).slice(0, 2) } }));
}
interface Props { post: Post; previous?: Post; next?: Post; related: Post[]; }
const { post, previous, next, related } = Astro.props;
const { Content, headings } = await render(post);
const languageAnchors = [{ id: 'ukrainian', label: 'UA' }, { id: 'english', label: 'EN' }, { id: 'japanese', label: 'JP' }].filter(anchor => headings.some(heading => heading.slug === anchor.id) || new RegExp(`id=["']${anchor.id}["']`).test(post.body || ''));
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'BlogPosting', headline: post.data.title,
  description: post.data.description, datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate || post.data.pubDate).toISOString(),
  author: { '@type': 'Person', name: site.author, url: new URL('/about/', Astro.site).href },
  mainEntityOfPage: new URL(postUrl(post), Astro.site).href,
  image: new URL(post.data.image || '/images/social.jpg', Astro.site).href,
  keywords: post.data.tags.join(', '), inLanguage: post.data.language === 'multilingual' ? ['uk', 'en', 'ja'] : post.data.language,
  publisher: { '@type': 'Person', name: site.author }
};
---
<BaseLayout title={post.data.title} description={post.data.description} image={post.data.image} article lang={post.data.language === 'multilingual' ? 'en' : post.data.language}>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\u003c')} /><meta property="article:published_time" content={post.data.pubDate.toISOString()} /><meta property="article:modified_time" content={(post.data.updatedDate || post.data.pubDate).toISOString()} /></Fragment>
  <main id="main" class="shell page-main"><a href="/blog/" class="text-link back-link">← Back to the blog</a><div class="content-grid"><div class="main-column"><article class="post-detail panel"><header class="post-detail-header"><span class="eyebrow">{post.data.category} · {languageLabel(post.data.language)}</span><h1>{post.data.title}</h1><div class="post-date"><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time><span> · {readingTime(post)} min read</span>{post.data.updatedDate && <span> · Updated <time datetime={post.data.updatedDate.toISOString()}>{formatDate(post.data.updatedDate)}</time></span>}</div><div class="tags">{post.data.tags.map(tag => <a href={tagUrl(tag)}>{tag}</a>)}</div>{languageAnchors.length > 0 && <nav class="language-nav" aria-label="Read in your language"><span>A little hello in your language</span>{languageAnchors.map(anchor => <a href={`#${anchor.id}`}>{anchor.label}</a>)}</nav>}</header>{post.data.image && <img class="post-cover" src={post.data.image} alt={post.data.imageAlt || 'Sakura Miyu’s Gothic Kawaii illustration'} width="800" height="450" fetchpriority="high" />}<div class="prose"><Content /></div><div class="author-signature"><img src="/images/avatar.webp" alt="" width="44" height="44" loading="lazy" /><div>With a little love,<strong>Sakura Miyu <span aria-hidden="true">♡</span></strong></div></div><Share title={post.data.title} image={post.data.image} /></article>{(previous || next) && <nav class="post-pagination" aria-label="Adjacent posts">{previous && <a href={postUrl(previous)} rel="prev"><span class="small-label">← PREVIOUS POST</span>{previous.data.title}</a>}{next && <a href={postUrl(next)} rel="next"><span class="small-label">NEXT POST →</span>{next.data.title}</a>}</nav>}{related.length > 0 && <section class="related"><h2>A few more little stories</h2>{related.map(entry => <PostCard post={entry} />)}</section>}</div><Sidebar /></div><Follow /></main>
</BaseLayout>

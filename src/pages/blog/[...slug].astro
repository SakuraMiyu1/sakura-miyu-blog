---
import LegacyRedirect from '../../layouts/LegacyRedirect.astro';
import { legacyEntries, legacyTarget } from '../../lib/routes';
export async function getStaticPaths() { return (await legacyEntries()).map(post => ({ params: { slug: post.id }, props: { to: legacyTarget(post) } })); }
---
<LegacyRedirect to={Astro.props.to} />

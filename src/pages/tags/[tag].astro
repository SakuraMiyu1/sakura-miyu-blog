---
import LegacyRedirect from '../../layouts/LegacyRedirect.astro';
import { allTags, slugify } from '../../lib/blog';
export async function getStaticPaths() { const ukrainian = new Set((await allTags('uk')).map(slugify)); return (await allTags()).map(tag => ({ params: { tag: slugify(tag) }, props: { to: ukrainian.has(slugify(tag)) ? `/uk/tags/${slugify(tag)}/` : '/uk/tags/' } })); }
---
<LegacyRedirect to={Astro.props.to} />

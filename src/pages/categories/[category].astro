---
import LegacyRedirect from '../../layouts/LegacyRedirect.astro';
import { categories, slugify } from '../../lib/blog';
export function getStaticPaths() { return categories.map(category => ({ params: { category: slugify(category) } })); }
---
<LegacyRedirect to={`/uk/categories/${Astro.params.category}/`} />
